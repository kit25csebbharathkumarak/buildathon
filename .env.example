# TalentLens Environment Configuration
# Optional: Anthropic API Key (Generative layer for Claude Sonnet 4.6)
# When omitted, TalentLens automatically operates in autonomous local mode with zero external dependencies.
ANTHROPIC_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Google OAuth Client ID for "Sign In with Google"
# When omitted, TalentLens provides one-click interactive demonstration Google authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: Google reCAPTCHA v2 / v3 Keys
# When omitted, TalentLens activates its built-in interactive bot defense checkpoint
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
